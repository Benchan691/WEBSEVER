# Mongo and signed session configuration
LOCAL_MONGO_URI=mongodb://localhost:27017/
FLASK_SECRET_KEY=replace-with-a-long-random-secret
WEB_DATABASE=web
VULNERABILITIES_DATABASE=vulnerabilities
VULNERABILITIES_COLLECTION=news
ACCOUNT_COLLECTION=accounts

# Exactly one local break-glass administrator is created in web.accounts.
WEB_AUTH_BOOTSTRAP_USERNAME=admin
WEB_AUTH_BOOTSTRAP_PASSWORD=replace-with-a-strong-password

# HTTPS production cookies; set false only for loopback HTTP development.
WEB_AUTH_COOKIE_SECURE=true

# Required for creating accounts and issuing temporary passwords, as well as delivery.
# SMTP_USERNAME and SMTP_PASSWORD are both optional; leave both empty for
# relays that accept unauthenticated submission from the SMTP_FROM address.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Optional PEM file (absolute, or relative to the application root) with a
# private CA to trust in addition to the public roots, for relays whose
# certificate is signed by an internal CA.
SMTP_CA_BUNDLE=

# Optional canonical portal URL for the sign-in link in credential emails.
WEB_PUBLIC_URL=

NEWSLETTER_ROOT=newsletters
RUST_SCHEDULER_ENABLED=false
