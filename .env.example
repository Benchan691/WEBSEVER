# Mongo and signed session configuration
LOCAL_MONGO_URI=mongodb://localhost:27017/
FLASK_SECRET_KEY=replace-with-a-long-random-secret
WEB_DATABASE=web
VULNERABILITIES_DATABASE=vulnerabilities
ACCOUNT_COLLECTION=accounts

# Exactly one local break-glass administrator is created in web.accounts.
WEB_AUTH_BOOTSTRAP_USERNAME=admin
WEB_AUTH_BOOTSTRAP_PASSWORD=replace-with-a-strong-password

# Zimbra end-user authentication and direct news delivery
ZIMBRA_BASE_URL=https://zmailbox.citictel-cpc.com
ZIMBRA_FOLDER_NAME=news
ZIMBRA_TIMEOUT_SECONDS=10
ZIMBRA_VERIFY_TLS=true
# Base64 encoding of a randomly generated 32-byte AES-256-GCM key.
ZIMBRA_CREDENTIAL_KEY=

# SMTP is used only for recipients that are not provisioned Zimbra accounts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

NEWSLETTER_ROOT=newsletters
RUST_SCHEDULER_ENABLED=false
