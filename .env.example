# Secrets and connection strings only. Non-sensitive settings live in config/config.json.
# Environment variables override config.json when both are set.

# MongoDB URI for both web and vulnerabilities databases (same server, different DB names).
# MONGO_URI overrides LOCAL_MONGO_URI when both are set.
LOCAL_MONGO_URI=mongodb://localhost:27017/
# Docker Compose overrides LOCAL_MONGO_URI to host.docker.internal for web.
FLASK_SECRET_KEY=change-me
# The one local break-glass administrator (never an Account Hub allowlist row).
WEB_AUTH_BOOTSTRAP_USERNAME=admin
WEB_AUTH_BOOTSTRAP_PASSWORD=change-me

# Account Hub password login (set ACCOUNT_HUB_ENABLED=true after testing URLs).
# Supply full HTTPS URLs; do not infer path composition.
ACCOUNT_HUB_ENABLED=false
# Current Account Hub login API: https://<host>/accounthub-api-gateway/auth/user/oauth/login
ACCOUNT_HUB_LOGIN_URL=
# Current Account Hub user-info API: https://<host>/accounthub-api-gateway/user/open-api/v1/user/view/info
ACCOUNT_HUB_TOKEN_CHECK_URL=
# Account Hub roleName required for portal access (defaults to CVE-SYSTEM).
ACCOUNT_HUB_REQUIRED_ROLE=CVE-SYSTEM
# A matching <required-role>-admin system role (for example CVE-SYSTEM-admin)
# grants organization-member management for that user's Account Hub organization.
ACCOUNT_HUB_TIMEOUT_SECONDS=5
# Complete Account Hub user directory used by the background synchronizer.
# The service token is read only from this .env file and is never stored in MongoDB.
ACCOUNT_HUB_DIRECTORY_URL=https://test-accounthub.cloudtimes.net.cn/accounthub-api-gateway/user/open-api/v1/getAllPersonnelList
ACCOUNT_HUB_DIRECTORY_TOKEN=
ACCOUNT_HUB_SYNC_INTERVAL_SECONDS=300

TAVILY_API_KEY=
TAVILY_API_KEYS=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Enable only after validating the Rust subscription filters and email output.
RUST_SCHEDULER_ENABLED=false
